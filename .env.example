# Configuración de base de datos
# Copiar este archivo a .env y ajustar los valores

# PostgreSQL (para usar con docker-compose)
DATABASE_URL=postgresql://postgres:postgres@db:5432/analytics

# Para conexión externa (ajustar según tu BD)
# DATABASE_URL=postgresql://user:password@host:5432/database

# MySQL (si prefieres MySQL)
# DATABASE_URL=mysql+pymysql://user:password@host:3306/database

# Directorio de salida para archivos generados
OUTPUT_DIR=/app/outputs
